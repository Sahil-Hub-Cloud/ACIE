# Use Node LTS image
FROM node:22-alpine AS base

# Install pnpm globally
RUN npm install -g pnpm@10.30.2

WORKDIR /app

# Copy root monorepo package configs
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./

# Copy packages and apps configs
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/typescript-config/package.json ./packages/config/typescript-config/
COPY packages/config/eslint-config/package.json ./packages/config/eslint-config/
COPY apps/cli/package.json ./apps/cli/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy full source
COPY . .

# Build workspace packages & api
RUN pnpm --filter @acie/shared build
RUN pnpm --filter @acie/api build

EXPOSE 3001

ENV NODE_ENV=production
ENV DATABASE_PATH=/app/data/acie.db

CMD ["pnpm", "--filter", "@acie/api", "start"]
