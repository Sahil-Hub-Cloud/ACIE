# Build and run the ACIE web app (Next.js dashboard + API route handlers).
FROM node:22-alpine

# Install pnpm globally
RUN npm install -g pnpm@10.30.2

WORKDIR /app

# Copy root monorepo package configs
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./

# Copy workspace package manifests for dependency resolution
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/typescript-config/package.json ./packages/config/typescript-config/
COPY packages/config/eslint-config/package.json ./packages/config/eslint-config/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy full source
COPY . .

# Build shared types, then the web app
RUN pnpm --filter @acie/shared build
RUN pnpm --filter @acie/web build

EXPOSE 3000

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "@acie/web", "start"]