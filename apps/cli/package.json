{
  "name": "@acie/cli",
  "version": "0.1.0",
  "private": true,
  "description": "ACIE CLI — Index repos and analyze blast radius from the command line",
  "bin": {
    "acie": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --dts --clean --shims --external better-sqlite3 --external tree-sitter --external tree-sitter-typescript --external bindings",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@acie/shared": "workspace:*",
    "@acie/engine": "workspace:*",
    "better-sqlite3": "^9.4.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.0",
    "ora": "^8.0.1",
    "simple-git": "^3.20.0"
  },
  "optionalDependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0"
  },
  "devDependencies": {
    "@acie/eslint-config": "workspace:*",
    "@acie/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
