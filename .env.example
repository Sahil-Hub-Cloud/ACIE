# =============================================================
# ACIE - Environment Variables
# Copy this file to .env.local (or .env) and fill in your values.
# NEVER commit real secrets to version control.
# =============================================================

# --- GitHub OAuth (required for "Sign in with GitHub") ---
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set the Authorization callback URL to: https://<your-domain>/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Only set this when the callback URL registered on the OAuth App
# does not match https://<current-host>/login (custom domains, preview builds,
# or an app that is still registered against an older domain).
# GITHUB_OAUTH_REDIRECT_URI=https://acie-gamma.vercel.app/login

# Optional legacy alias. Sign-in now starts from a server route
# (/api/auth/github/authorize), so the client id only needs to exist server-side
# and changing it no longer requires a rebuild.
# NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- GitHub API (webhooks and repo access) ---
# Personal access token with repo scope, or GitHub App token
GITHUB_TOKEN=

# Webhook secret configured in your GitHub App/webhook settings
GITHUB_WEBHOOK_SECRET=

# --- Authentication ---
# Secret key for signing JWTs. Generate with: openssl rand -hex 32
# Sign-in will fail with a 503 until this is set.
JWT_SECRET=

# --- Database (Turso / libSQL) ---
# Get from: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- App configuration ---
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NODE_ENV=development
