# =============================================================
# ACIE - Environment Variables
# Copy this file to .env.local (or .env) and fill in your values.
# NEVER commit real secrets to version control.
# =============================================================

# --- GitHub App (preferred) -----------------------------------
# Register at: https://github.com/settings/apps -> New GitHub App
#
#   Homepage URL          https://<your-domain>
#   Callback URL          https://<your-domain>/login    (up to 10 allowed)
#   Setup URL             https://<your-domain>/api/auth/github/setup
#   Webhook URL           https://<your-domain>/api/webhooks/analyze
#
# Permissions:  Pull requests: Read & write | Contents: Read | Metadata: Read
# Events:       Pull request, Installation, Installation repositories
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional — only needed if /app lookup is unavailable. Your app's URL slug.
# GITHUB_APP_SLUG=

# --- GitHub OAuth (used to sign users in) ---------------------
# A GitHub App provides these under "Client secrets". A classic OAuth App
# works too, but only allows a single callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Pin the callback when it differs from https://<current-host>/login
# (custom domains, preview builds, or an app registered against another domain).
# GITHUB_OAUTH_REDIRECT_URI=https://acie-gamma.vercel.app/login

# Optional legacy alias. Sign-in starts from a server route
# (/api/auth/github/authorize), so the client id only needs to exist server-side.
# NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- GitHub API fallback --------------------------------------
# Personal access token with `repo` scope. Only used when the GitHub App is not
# installed on the target repository.
GITHUB_TOKEN=

# Webhook secret configured on the GitHub App ("Webhook secret").
# Without it, the webhook accepts unsigned requests and rejects nothing.
GITHUB_WEBHOOK_SECRET=

# --- Authentication -------------------------------------------
# Secret key for signing JWTs. Generate with: openssl rand -hex 32
# Sign-in fails with a 503 until this is set.
JWT_SECRET=

# --- Database (Turso / libSQL) --------------------------------
# Get from: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- App configuration ----------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NODE_ENV=development
