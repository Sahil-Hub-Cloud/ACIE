# =============================================================
# ACIE - Environment Variables
# Copy this file to .env.local (or .env) and fill in your values.
# NEVER commit real secrets to version control.
# =============================================================

# --- GitHub OAuth (required for "Sign in with GitHub") ---
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set the Authorization callback URL to: https://<your-domain>/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public variant needed by the browser (Next.js client-side)
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- GitHub API (webhooks and repo access) ---
# Personal access token with repo scope, or GitHub App token
GITHUB_TOKEN=

# Webhook secret configured in your GitHub App/webhook settings
GITHUB_WEBHOOK_SECRET=

# --- Authentication ---
# Secret key for signing JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Database (Turso / LibSQL) ---
# Get from: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- App configuration ---
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NODE_ENV=development