# ACIE 2.0 Environment Variables
# Copy to .env and fill in values

# ── GitHub App ──────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=   # Base64 encoded PEM key
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=             # Personal access token for API calls

# ── Auth ─────────────────────────────────────────────────────────
SESSION_SECRET=a_random_32_character_string_here
JWT_SECRET=another_random_jwt_secret_here
JWT_EXPIRY=7d

# ── Database ─────────────────────────────────────────────────────
DATABASE_PATH=./data/acie.db          # Local SQLite path (CLI + API dev)
TURSO_DATABASE_URL=                   # libsql://... (production)
TURSO_AUTH_TOKEN=                     # Turso auth token (production)

# ── Supabase (V1 legacy, optional) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── API ──────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# ── Web ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (optional, for enhanced Copilot) ──────────────────────────
GEMINI_API_KEY=
